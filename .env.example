# Скопируйте в .env и заполните. Секреты генерируются так:  openssl rand -hex 32
DOMAIN=algotrain.example.com
POSTGRES_PASSWORD=
RUNNER_TOKEN=

# email администраторов через запятую (могут добавлять задачи через интерфейс)
ADMIN_EMAILS=you@example.com
# false — закрыть регистрацию новых пользователей
ALLOW_SIGNUP=true

# масштаб: экземпляров приложения, параллельных проверок и CPU для раннера
APP_REPLICAS=2
RUNNER_WORKERS=4
RUNNER_CPUS=4
RUNS_PER_MINUTE=20
DB_MAX_CONNS=20
